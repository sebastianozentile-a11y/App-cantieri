        val titolo = TextView(this).apply {
            text = "📄  NUOVA BOLLA"
            textSize = 27f
            setTextColor(Color.parseColor("#FFC400"))
            setTypeface(null, android.graphics.Typeface.BOLD)
            gravity = Gravity.CENTER
            setPadding(0, dp(8), 0, dp(18))
